#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

/ {
        macros {
                // Mouse Movement (4 directions, 0 params)
                mmv_up: mmv_up {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Up";
                        bindings = <&macro_press &mmv MOVE_UP>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_UP>;
                };
                mmv_down: mmv_down {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Down";
                        bindings = <&macro_press &mmv MOVE_DOWN>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_DOWN>;
                };
                mmv_left: mmv_left {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Left";
                        bindings = <&macro_press &mmv MOVE_LEFT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_LEFT>;
                };
                mmv_right: mmv_right {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Right";
                        bindings = <&macro_press &mmv MOVE_RIGHT>, <&macro_pause_for_release>, <&macro_release &mmv MOVE_RIGHT>;
                };

                // Mouse Scroll (4 directions, 0 params)
                msc_up: msc_up {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Scroll Up";
                        bindings = <&macro_press &msc SCRL_UP>, <&macro_pause_for_release>, <&macro_release &msc SCRL_UP>;
                };
                msc_down: msc_down {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Scroll Down";
                        bindings = <&macro_press &msc SCRL_DOWN>, <&macro_pause_for_release>, <&macro_release &msc SCRL_DOWN>;
                };
                msc_left: msc_left {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Scroll Left";
                        bindings = <&macro_press &msc SCRL_LEFT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_LEFT>;
                };
                msc_right: msc_right {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Scroll Right";
                        bindings = <&macro_press &msc SCRL_RIGHT>, <&macro_pause_for_release>, <&macro_release &msc SCRL_RIGHT>;
                };

                // Mouse Clicks (Left, Right, Middle, 0 params)
                mkp_lclk: mkp_lclk {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Left Click";
                        bindings = <&macro_press &mkp LCLK>, <&macro_pause_for_release>, <&macro_release &mkp LCLK>;
                };
                mkp_rclk: mkp_rclk {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Right Click";
                        bindings = <&macro_press &mkp RCLK>, <&macro_pause_for_release>, <&macro_release &mkp RCLK>;
                };
                mkp_mclk: mkp_mclk {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        display-name = "Mouse Middle Click";
                        bindings = <&macro_press &mkp MCLK>, <&macro_pause_for_release>, <&macro_release &mkp MCLK>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        bindings = <
   &kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE   &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &studio_unlock &studio_unlock &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &studio_unlock  &studio_unlock       &trans       &trans       &trans       &trans         &trans   &trans   &trans &trans    &trans &trans
                                    &kp LGUI     &trans       &kp SPACE      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
   &kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
   &kp LSHFT &trans   &trans &trans   &trans   &trans      &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                             &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
                        >;
                };

                system_layer {
                        display-name = "SYSTEM";
// -----------------------------------------------------------------------------------------
// |  TAB |      |  SCRL_UP  |           |       |      |   |      |      |  MMV_UP  |       |      | BKSP |
// | CTRL |      | SCRL_LEFT | SCRL_DOWN | SCRL_RIGHT | |   |      | MMV_LEFT | MMV_DOWN | MMV_RIGHT |  |      |
// | SHFT |      |   LCLK    |   MCLK    |   RCLK     | |   |      | LCLK |   MCLK   | RCLK  |      |      |
//                           |   GUI     |   LWR      | SPC |   | ENT  | RSE  |  ALT  |
                        bindings = <
   &kp TAB   &none &msc_up   &none     &none      &none     &none &none      &mmv_up   &none       &none &kp BSPC
   &kp LCTRL &none &msc_left &msc_down &msc_right &none     &none &mmv_left  &mmv_down &mmv_right  &none &none
   &kp LSHFT &none &mkp_lclk &mkp_mclk &mkp_rclk  &none     &none &mkp_lclk  &mkp_mclk &mkp_rclk   &none &none
                             &kp LGUI  &trans     &kp SPACE &kp RET &trans   &kp RALT
                        >;
                };
        };
};
